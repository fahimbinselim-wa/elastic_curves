 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"ChristoffelSymbol", "[", 
     RowBox[{"g_", ",", "xx_"}], "]"}], ":=", 
    RowBox[{"Block", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"n", ",", "ig", ",", "res"}], "}"}], ",", 
      RowBox[{
       RowBox[{"n", "=", 
        RowBox[{"Length", "[", "xx", "]"}]}], ";", 
       RowBox[{"ig", "=", 
        RowBox[{"Inverse", "[", "g", "]"}]}], ";", 
       RowBox[{"res", "=", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"(", 
            RowBox[{"1", "/", "2"}], ")"}], "*", 
           RowBox[{"Sum", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"ig", "[", 
               RowBox[{"[", 
                RowBox[{"i", ",", "s"}], "]"}], "]"}], "*", 
              RowBox[{"(", 
