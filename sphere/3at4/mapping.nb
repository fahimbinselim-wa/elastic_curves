Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"X", "[", 
     RowBox[{"u_", ",", "v_"}], "]"}], ":=", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{
       RowBox[{"Sin", "[", "u", "]"}], " ", 
       RowBox[{"Cos", "[", "v", "]"}]}], ",", 
      RowBox[{
       RowBox[{"Sin", "[", "u", "]"}], " ", 
       RowBox[{"Sin", "[", "v", "]"}]}], ",", 
      RowBox[{"Cos", "[", "u", "]"}]}], "}"}]}], ";"}], "\n", 
  RowBox[{"(*", 
   RowBox[{"First", " ", "derivatives"}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{"Xu", "=", 
  RowBox[{"D", "[", 
   RowBox[{
    RowBox[{"X", "[", 
     RowBox[{"u", ",", "v"}], "]"}], ",", "u"}], "]"}]}], "\n", 
 RowBox[{
  RowBox[{"Xv", "=", 
   RowBox[{"D", "[", 
    RowBox[{
     RowBox[{"X", "[", 
      RowBox[{"u", ",", "v"}], "]"}], ",", "v"}], "]"}]}], 
  "\[IndentingNewLine]", "\n", 
  RowBox[{"(*", 
   RowBox[{"Second", " ", "derivatives"}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Xuu", "=", 
   RowBox[{"D", "[", 
    RowBox[{
     RowBox[{"X", "[", 
      RowBox[{"u", ",", "v"}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"u", ",", "2"}], "}"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Xuv", "=", 
   RowBox[{"D", "[", 
    RowBox[{"Xu", ",", "v"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"Xvv", "=", 
    RowBox[{"D", "[", 
     RowBox[{
      RowBox[{"X", "[", 
       RowBox[{"u", ",", "v"}], "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"v", ",", "2"}], "}"}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"Normal", " ", "vector", " ", "to", " ", "surface"}], 
   "*)"}]}], "\n", 
 RowBox[{
  RowBox[{"nVec", "=", 
   RowBox[{
    RowBox[{"Cross", "[", 
     RowBox[{"Xv", ",", "Xu"}], "]"}], "//", "Simplify"}]}], 
  " "}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"n2", "=", 
   RowBox[{
    RowBox[{"Sqrt", "[", 
     RowBox[{"nVec", ".", "nVec"}], "]"}], "  ", "//", "FullSimplify"}]}], 
  " ", ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"n2", "=", 
   RowBox[{"Sin", "[", "u", "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"nVec", "=", 
    RowBox[{
     RowBox[{"nVec", "/", "n2"}], " ", "//", "FullSimplify"}]}], ";"}], "\n", 
  "\n", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
     RowBox[{"First", " ", "fundamental", " ", 
      RowBox[{"form", ":", "g_ij"}]}], "=", " ", 
     RowBox[{"<", "X_i"}]}], ",", 
    RowBox[{"X_j", ">"}]}], "*)"}]}], "\n", 
 RowBox[{
  RowBox[{"g11", "=", 
   RowBox[{"Simplify", "[", 
    RowBox[{"Xu", ".", "Xu"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"g12", "=", 
   RowBox[{"Simplify", "[", 
    RowBox[{"Xu", ".", "Xv"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"g22", "=", 
   RowBox[{"Simplify", "[", 
    RowBox[{"Xv", ".", "Xv"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"gMat", "=", 
   RowBox[{"{", 
