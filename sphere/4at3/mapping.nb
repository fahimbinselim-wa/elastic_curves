     RowBox[{
      RowBox[{"X", "[", 
       RowBox[{"u", ",", "v"}], "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"v", ",", "2"}], "}"}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]", "\[IndentingNewLine]", 
