Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"X", "[", 
    RowBox[{"u_", ",", "v_"}], "]"}], ":=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{"Cosh", "[", 
       RowBox[{"v", "/", "c"}], "]"}], " ", 
      RowBox[{"Cos", "[", "u", "]"}]}], ",", 
     RowBox[{
      RowBox[{"Cosh", "[", 
       RowBox[{"v", "/", "c"}], "]"}], " ", 
      RowBox[{"Sin", "[", "u", "]"}]}], ",", "v"}], "}"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"NN", "=", " ", 
   RowBox[{"nVec", "/.", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"u", "->", "u0"}], ",", 
      RowBox[{"v", "->", "v0"}]}], "}"}]}]}], " ", 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"X0", " ", "=", " ", 
   RowBox[{"X", "[", " ", 
    RowBox[{"u0", ",", "v0"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"X01", " ", "=", " ", 
   RowBox[{"D", "[", 
    RowBox[{"X0", ",", "x"}], "]"}]}], " ", ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"g1", "=", 
   RowBox[{
    RowBox[{"Sqrt", "[", 
     RowBox[{"X01", ".", "X01"}], "]"}], " ", "//", "Simplify"}]}], 
  ";"}], "\[IndentingNewLine]", 
