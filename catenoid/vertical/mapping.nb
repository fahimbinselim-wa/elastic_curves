  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"nn", "=", 
    RowBox[{
     RowBox[{"Cross", "[", 
      RowBox[{"NN", ",", "Xs"}], "]"}], " ", "//", "Simplify"}]}], ";"}], 
  "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"ns", "=", 
   RowBox[{
    RowBox[{"D", "[", 
     RowBox[{"nn", ",", "x"}], "]"}], "/", "g1"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"kg", "=", 
   RowBox[{
    RowBox[{"Xss", ".", "nn"}], "  ", "//", "Simplify"}]}], 
  "  "}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"kn", " ", "=", " ", 
   RowBox[{
    RowBox[{"Xss", ".", "NN"}], " ", "//", "Simplify"}]}], 
  "  "}], "\[IndentingNewLine]", 
 RowBox[{
