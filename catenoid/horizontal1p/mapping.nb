Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"X", "[", 
    RowBox[{"u_", ",", "v_"}], "]"}], ":=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{"Cosh", "[", 
       RowBox[{"v", "/", "c"}], "]"}], " ", 
      RowBox[{"Cos", "[", "u", "]"}]}], ",", 
     RowBox[{
      RowBox[{"Cosh", "[", 
       RowBox[{"v", "/", "c"}], "]"}], " ", 
      RowBox[{"Sin", "[", "u", "]"}]}], ",", "v"}], "}"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"NN", "=", " ", 
   RowBox[{"nVec", "/.", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"u", "->", "u0"}], ",", 
      RowBox[{"v", "->", "v0"}]}], "}"}]}]}], " ", 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"X0", " ", "=", " ", 
   RowBox[{"X", "[", " ", 
    RowBox[{"u0", ",", "v0"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"X01", " ", "=", " ", 
   RowBox[{"D", "[", 
    RowBox[{"X0", ",", "x"}], "]"}]}], " ", ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"g1", "=", 
   RowBox[{
    RowBox[{"Sqrt", "[", 
     RowBox[{"X01", ".", "X01"}], "]"}], " ", "//", "Simplify"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Xs", "=", 
   RowBox[{"X01", "/", "g1"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Xss", " ", "=", " ", 
   RowBox[{
    RowBox[{"D", "[", 
     RowBox[{"Xs", ",", "x"}], "]"}], "/", "g1"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"nn", "=", 
    RowBox[{
     RowBox[{"Cross", "[", 
      RowBox[{"NN", ",", "Xs"}], "]"}], " ", "//", "Simplify"}]}], ";"}], 
  "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"ns", "=", 
   RowBox[{
    RowBox[{"D", "[", 
     RowBox[{"nn", ",", "x"}], "]"}], "/", "g1"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"kg", "=", 
   RowBox[{
    RowBox[{"Xss", ".", "nn"}], "  ", "//", "Simplify"}]}], 
  "  "}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"kn", " ", "=", " ", 
   RowBox[{
    RowBox[{"Xss", ".", "NN"}], " ", "//", "Simplify"}]}], 
  "  "}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"taug", " ", "=", " ", 
   RowBox[{
    RowBox[{"ns", ".", "NN"}], " ", "//", "Simplify"}]}], 
  "  "}], "\[IndentingNewLine]"}], "Input",
